{
  "uid": "caseflow-operations",
  "title": "CaseFlow operations",
  "tags": [
    "caseflow",
    "local-release"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "HTTP acknowledgement p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "caseflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"caseflow-api\",uri!~\"/actuator.*\"}[5m])))",
          "refId": "A",
          "legendFormat": "API"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "HTTP request rate / route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "caseflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"caseflow-api\",uri!~\"/actuator.*\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Ready-to-claim queue p95",
